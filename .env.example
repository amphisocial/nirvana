# ─────────────────────────────────────────────────────────────
# NIRVANA — copy to .env.local and fill in what you have.
# The app runs fully WITHOUT any keys (mock market data + a
# rule-based "simulated analyst" engine). Add keys to go live.
# ─────────────────────────────────────────────────────────────

# --- AI agents ---
# Provider: anthropic | openai | gemini | mock
# If AI_PROVIDER is unset, it's inferred from whichever key is present below.
# With no key (or mock), agents run in DETERMINISTIC SIMULATION mode.
AI_PROVIDER=anthropic
# AI_MODEL must match the chosen provider. Examples:
#   anthropic -> claude-sonnet-4-6     openai -> gpt-4o-mini     gemini -> gemini-1.5-flash
AI_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Market data ---
# Provider: mock | finnhub | alphavantage   (mock works offline, out of the box)
# Recommended: finnhub (60 req/min free) — Alpha Vantage's free daily cap (~25/day)
# is too low for the movers screen, so it's capped hardest and falls back to mock
# when rate-limited.
MARKET_DATA_PROVIDER=mock
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
# Which listing universe to build portfolios from: nasdaq | nyse | both
MARKET_LISTING=both


# --- Database (optional) ---
# When set, portfolios + blog posts persist to Postgres. When unset, the app
# falls back to JSON files in ./data (fine for a single instance / local dev).
DATABASE_URL=
# Set PGSSL=require for managed Postgres that mandates TLS (e.g. RDS, Neon).
PGSSL=

# --- Nightly "AI Analyst of the Day" blog run ---
# Admin is the only human in the loop. Turn the nightly job on/off here.
NIGHTLY_ENABLED=true
# Secret required to trigger POST /api/cron/nightly (set on your scheduler).
CRON_SECRET=change-me


# --- Google Sign-In (required to save portfolios) ---
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:  <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public URL of the app (behind nginx use the https domain, no trailing slash).
NEXTAUTH_URL=http://localhost:5015
# Session signing secret — generate: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Admin ---
ADMIN_EMAIL=admin@nirvana.capital
